#!/usr/bin/env python3
"""gitx — stateless git lane for agents. See README.md."""
import argparse
import base64 as _b64
import bisect
import hashlib
import json
import os
import posixpath
import shlex
import signal
import subprocess
import sys
import time
from urllib.parse import quote


class GitxError(Exception):
    def __init__(self, code, msg, data=None):
        super().__init__(msg)
        self.code = code
        self.msg = msg
        self.data = data or {}


ERROR_NAMES = {1: "error", 2: "not_authenticated", 3: "not_found",
               4: "head_conflict", 5: "unseen_change"}


def validate_repo_path(path):
    """Return a clean repo-relative POSIX path, or raise GitxError(3)."""
    if path.startswith("/") or os.path.isabs(path):
        raise GitxError(3, f"path must be repo-relative, got absolute: {path!r}")
    norm = posixpath.normpath(path)
    if norm.startswith("..") or norm == "." or norm.startswith("/"):
        raise GitxError(3, f"path escapes repo root: {path!r}")
    return norm


def parse_ref_path(arg):
    """Split '<ref>:<path>' into (ref, repo_path). Path is validated."""
    if ":" not in arg:
        raise GitxError(3, f"expected <ref>:<path>, got {arg!r}")
    ref, _, path = arg.partition(":")
    if not ref or not path:
        raise GitxError(3, f"empty ref or path in {arg!r}")
    return ref, validate_repo_path(path)


COMMIT_MUTATION = """mutation($input: CreateCommitOnBranchInput!) {
  createCommitOnBranch(input: $input) {
    commit { oid url }
  }
}"""


def build_commit_body(repo, branch, message, head_oid, files):
    """Return a GraphQL request body for createCommitOnBranch mutation.

    Args:
        repo: Repository in 'owner/repo' format.
        branch: Branch name.
        message: Commit message (headline).
        head_oid: Expected HEAD OID.
        files: List of (path, bytes) tuples. Contents are base64-encoded.

    Returns:
        Dict with 'query' and 'variables' keys ready for 'gh api graphql --input -'.
    """
    additions = [
        {"path": path, "contents": _b64.b64encode(data).decode("ascii")}
        for path, data in files
    ]
    return {
        "query": COMMIT_MUTATION,
        "variables": {
            "input": {
                "branch": {
                    "repositoryNameWithOwner": repo,
                    "branchName": branch,
                },
                "message": {"headline": message},
                "expectedHeadOid": head_oid,
                "fileChanges": {"additions": additions},
            }
        },
    }


def is_stale_head_error(stderr):
    """Return True if stderr indicates an expected-head-OID mismatch (stale HEAD)."""
    s = stderr.lower()
    return "expected" in s or "is at" in s or "stale" in s


def usage_dir():
    """Return the usage telemetry directory, honoring $GITX_HOME. Creates it if absent."""
    d = os.environ.get("GITX_HOME") or os.path.join(os.path.expanduser("~"), ".gitx")
    os.makedirs(d, exist_ok=True)
    return d


def log_usage(cmd, ok, ms, error):
    """Append one JSON line to usage_dir()/usage.jsonl with telemetry."""
    if os.environ.get("DO_NOT_TRACK") == "1":
        return
    line = json.dumps({
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "cmd": cmd,
        "ok": ok,
        "ms": ms,
        "error": error,
    })
    path = os.path.join(usage_dir(), "usage.jsonl")
    if not os.path.exists(path):
        print(f"gitx: logging usage to {path} — set DO_NOT_TRACK=1 to disable",
              file=sys.stderr)
    with open(path, "a") as f:
        f.write(line + "\n")


def gh(args, stdin=None):
    proc = subprocess.run(
        ["gh"] + args,
        input=stdin,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        err = (proc.stderr or "").strip()
        low = err.lower()
        if "auth" in low or "not logged" in low:
            raise GitxError(2, f"gh not authenticated: {err}")
        raise GitxError(1, f"gh {' '.join(args)} failed: {err}")
    return proc.stdout


def resolve_repo(explicit):
    if explicit:
        return explicit
    out = gh(["repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"]).strip()
    if not out:
        raise GitxError(3, "not in a git repo; pass --repo owner/name")
    return out


def repo_default_branch(repo):
    return gh([
        "repo", "view", repo, "--json", "defaultBranchRef",
        "-q", ".defaultBranchRef.name",
    ]).strip()


_REF_QUERY = """query($owner:String!,$name:String!,$qual:String!){
  repository(owner:$owner,name:$name){ ref(qualifiedName:$qual){ target{ oid } } }
}"""


def branch_head_oid(repo, branch):
    owner, name = repo.split("/", 1)
    out = gh([
        "api", "graphql",
        "-f", f"query={_REF_QUERY}",
        "-F", f"owner={owner}", "-F", f"name={name}",
        "-F", f"qual=refs/heads/{branch}",
        "-q", ".data.repository.ref.target.oid",
    ]).strip()
    return out or None


def start_oid(repo, from_ref):
    """The commit a missing branch will be created at."""
    start = from_ref or repo_default_branch(repo)
    oid = branch_head_oid(repo, start)
    if not oid:
        raise GitxError(3, f"base ref {start!r} not found in {repo}")
    return oid


def create_branch(repo, branch, oid):
    gh([
        "api", "-X", "POST", f"/repos/{repo}/git/refs",
        "-f", f"ref=refs/heads/{branch}",
        "-f", f"sha={oid}",
    ])


# --- overwrite guard -------------------------------------------------------
# `put` sends whole files. If the branch changed a file after the caller read it,
# a blind put erases that change (airshelf 4cffc4f9c erased a29cecbce's row,
# 2026-09-25). So put refuses when the branch holds a version the caller never saw.
# What counts as "seen" depends on what gitx can know about where the copy came from:
#   base      --base <rev>: the version at that commit.
#   checkout  cwd is the top of a checkout of the repo: every version in HEAD's
#             history of the path, plus the staged copy.
#   content   nothing known: refuse only if the put would drop a line the branch has.

_BLOBS_QUERY = """query($owner:String!,$name:String!,$rev:String!%s){
  repository(owner:$owner,name:$name){ rev: object(expression:$rev){ oid } %s }
}"""

_LOG_QUERY = """query($owner:String!,$name:String!,$rev:String!,$path:String!,$n:Int!){
  repository(owner:$owner,name:$name){ object(expression:$rev){ ... on Commit {
    history(first:$n, path:$path){ nodes{ oid messageHeadline file(path:$path){ oid } } }
  } } }
}"""

LOG_LIMIT = 10


def _graphql(repo, query, variables):
    owner, name = repo.split("/", 1)
    body = {"query": query, "variables": dict(variables, owner=owner, name=name)}
    return json.loads(gh(["api", "graphql", "--input", "-"], stdin=json.dumps(body)))["data"]


def remote_blobs(repo, rev, paths):
    """(commit oid of rev or None, {path: blob oid or None}) in one query."""
    decl = "".join(f",$e{i}:String!" for i in range(len(paths)))
    fields = " ".join(f"p{i}: object(expression:$e{i}){{ oid }}" for i in range(len(paths)))
    variables = {"rev": rev, **{f"e{i}": f"{rev}:{p}" for i, p in enumerate(paths)}}
    r = _graphql(repo, _BLOBS_QUERY % (decl, fields), variables)["repository"]
    oid = (r.get("rev") or {}).get("oid")
    return oid, {p: (r.get(f"p{i}") or {}).get("oid") for i, p in enumerate(paths)}


def path_log(repo, rev, path, n):
    """Newest-first commits at rev that touched path: [{sha, subject, blob}]."""
    obj = _graphql(repo, _LOG_QUERY, {"rev": rev, "path": path, "n": n})["repository"]["object"]
    nodes = ((obj or {}).get("history") or {}).get("nodes") or []
    return [{"sha": c["oid"], "subject": c["messageHeadline"],
             "blob": (c.get("file") or {}).get("oid")} for c in nodes]


def git_blob_oid(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def _git(*args):
    p = subprocess.run(["git", *args], capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 else None


def _repo_from_url(url):
    """owner/name from an https or ssh GitHub remote URL."""
    tail = url.rstrip("/").removesuffix(".git").replace(":", "/")
    return "/".join(tail.split("/")[-2:]).lower()


def checkout_seen(repo, paths):
    """{path: blobs the cwd checkout has held}, or None if cwd is not its top."""
    top = _git("rev-parse", "--show-toplevel")
    url = _git("remote", "get-url", "origin")
    if not top or not url or os.path.realpath(top) != os.path.realpath(os.getcwd()):
        return None
    if _repo_from_url(url) != repo.lower():
        return None
    seen = {}
    for p in paths:
        raw = _git("log", "--raw", "--no-abbrev", "--format=", "HEAD", "--", p) or ""
        blobs = {b for line in raw.splitlines() if line.startswith(":")
                 for b in line.split()[2:4]}
        staged = (_git("ls-files", "-s", "--", p) or "").split()
        blobs |= {_git("rev-parse", "-q", "--verify", f"HEAD:{p}"),
                  staged[1] if len(staged) > 1 else None}
        seen[p] = blobs - {None, "0" * 40}
    return seen


def resolve_seen(repo, base, paths):
    """(mode, base oid, {path: seen blobs}) for the guard."""
    if base:
        oid, blobs = remote_blobs(repo, base, paths)
        if not oid:
            raise GitxError(3, f"--base {base!r} is not a commit in {repo}. Pass the commit "
                               f"you read the files at (gitx cat --json prints it as .commit)")
        return "base", oid, {p: {b} - {None} for p, b in blobs.items()}
    seen = checkout_seen(repo, paths)
    if seen is not None:
        return "checkout", None, seen
    return "content", None, {p: set() for p in paths}


def _missing_lines(theirs, mine):
    """Lines of theirs that mine drops. Empty iff theirs is a subsequence of mine,
    i.e. mine only inserts lines. Greedy match on a line → positions index."""
    positions = {}
    for k, line in enumerate(mine.splitlines()):
        positions.setdefault(line, []).append(k)
    i, missing = 0, []
    for line in theirs.splitlines():
        ps = positions.get(line, [])
        j = bisect.bisect_left(ps, i)
        if j < len(ps):
            i = ps[j] + 1
        else:
            missing.append(line)
    return missing


def _remote_text(repo, oid):
    blob = json.loads(gh(["api", f"/repos/{repo}/git/blobs/{oid}"]))
    return _b64.b64decode(blob.get("content") or "")


def guard(repo, args, head, files, mode, base, seen):
    """Raise GitxError(5) if putting files at head would erase a version not seen."""
    _, blobs = remote_blobs(repo, head, [p for p, _ in files])
    refused = []
    for path, data in files:
        theirs = blobs[path]
        if theirs is None or theirs == git_blob_oid(data) or theirs in seen[path]:
            continue
        entry = {"path": path, "branch_blob": theirs}
        if mode == "content":
            text = _remote_text(repo, theirs)
            missing = _missing_lines(text.decode("utf-8", "replace"),
                                     data.decode("utf-8", "replace"))
            if not missing:
                continue
            entry["missing_lines"] = missing[:3]
        log = path_log(repo, head, path, LOG_LIMIT)
        unseen = []
        for c in log:
            if c["blob"] in seen[path]:
                break
            unseen.append({"sha": c["sha"], "subject": c["subject"]})
        entry["commits"] = unseen
        entry["truncated"] = len(unseen) == len(log) == LOG_LIMIT
        refused.append(entry)
    if refused:
        raise _unseen_change(repo, args, head, mode, base, refused)


def _unseen_change(repo, args, head, mode, base, refused):
    why = {
        "base": f"changed since --base {(base or '')[:9]}",
        "checkout": "holds a version this checkout has never had",
        "content": "has lines your copy lacks, and gitx cannot tell which version you read",
    }[mode]
    names = ", ".join(e["path"] for e in refused)
    put = ["gitx", "put", args.branch, *args.paths, "-m", args.message,
           "--repo", repo, "--base", head]
    if args.from_ref:
        put += ["--from", args.from_ref]
    fix = [shlex.join(["gitx", "cat", f"{head}:{e['path']}", "--repo", repo])
           for e in refused] + [shlex.join(put)]
    lines = [f"refusing to overwrite: {args.branch} {why}: {names}"]
    for e in refused:
        lines += [f"  {e['path']}" + (" (recent commits):" if mode == "content" else ":")]
        lines += [f"    {c['sha'][:9]} {c['subject']}" for c in e["commits"]]
        lines += [f"    missing line: {m}" for m in e.get("missing_lines", [])]
    lines += ["Fix: read the branch copy, re-apply your change to it, put against that commit:"]
    lines += [f"  {c}" for c in fix]
    lines += ["Or overwrite on purpose, dropping the changes above: add --force"]
    data = {"repo": repo, "branch": args.branch, "head": head, "mode": mode,
            "base": base, "paths": refused, "fix": fix}
    return GitxError(5, "\n".join(lines), data)


def run_commit(repo, branch, message, head_oid, files):
    body = build_commit_body(repo, branch, message, head_oid, files)
    out = gh(["api", "graphql", "--input", "-"], stdin=json.dumps(body))
    data = json.loads(out)["data"]["createCommitOnBranch"]["commit"]
    return {"sha": data["oid"], "url": data["url"]}


def _read_files(paths):
    files = []
    for p in paths:
        repo_path = validate_repo_path(p)
        try:
            with open(p, "rb") as fh:
                data = fh.read()
        except (FileNotFoundError, IsADirectoryError, PermissionError) as e:
            raise GitxError(3, f"cannot read {p}: {e}")
        files.append((repo_path, data))
    return files


def cmd_put(args):
    repo = resolve_repo(args.repo)
    files = _read_files(args.paths)
    if not args.force:
        mode, base, seen = resolve_seen(repo, args.base, [p for p, _ in files])
    head = branch_head_oid(repo, args.branch)
    create = head is None
    if create:
        head = start_oid(repo, args.from_ref)
    for attempt in (1, 2):
        # Re-check on retry: the commit that moved the head may be the race itself.
        if not args.force:
            guard(repo, args, head, files, mode, base, seen)
        if create:
            create_branch(repo, args.branch, head)
            create = False
        try:
            commit = run_commit(repo, args.branch, args.message, head, files)
            break
        except GitxError as e:
            if not is_stale_head_error(e.msg):
                raise
            if attempt == 2:
                raise GitxError(4, f"head moved twice under us on {args.branch}; retry")
            head = branch_head_oid(repo, args.branch)
    return {
        "sha": commit["sha"],
        "url": commit["url"],
        "branch": args.branch,
        "files": [p for p, _ in files],
    }


def cmd_cat(args):
    ref, path = parse_ref_path(args.ref_path)
    repo = resolve_repo(args.repo)
    try:
        # Resolve once and read at that commit, so .commit is exactly what was read:
        # it is the --base for a later put of this file.
        commit = gh(["api", "-H", "Accept: application/vnd.github.sha",
                     f"/repos/{repo}/commits/{quote(ref, safe='')}"]).strip()
        out = gh(["api", f"/repos/{repo}/contents/{path}?ref={commit}"])
    except GitxError as e:
        if "404" in e.msg or "422" in e.msg:
            raise GitxError(3, f"{ref}:{path} not found in {repo}")
        raise
    payload = json.loads(out)
    if isinstance(payload, list) or payload.get("type") != "file":
        raise GitxError(3, f"{ref}:{path} is not a file in {repo}")
    content = _decode_blob(repo, ref, path, payload)
    return {
        "ref": ref, "commit": commit, "path": path,
        "sha": payload["sha"], "size": payload["size"], "content": content,
    }


def _decode_blob(repo, ref, path, payload):
    """Return the file's text, escalating past the contents API's 1MB cap.

    Above 1MB the contents API returns `encoding: "none"` and an EMPTY content field
    with HTTP 200 — decoding that naively yields "" and reports a real file as empty.
    Escalate to the blobs API (100MB cap) by sha, and refuse binary loudly rather than
    emitting replacement-char mojibake.
    """
    b64 = payload.get("content") or ""
    size = payload.get("size") or 0
    if not b64 and size:
        blob = json.loads(gh(["api", f"/repos/{repo}/git/blobs/{payload['sha']}"]))
        b64 = blob.get("content") or ""
        if not b64:
            raise GitxError(3, f"{ref}:{path} is {size} bytes — too large to fetch "
                               f"(blob API caps at 100MB)")
    raw = _b64.b64decode(b64)
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        raise GitxError(3, f"{ref}:{path} is binary ({size} bytes); gitx cat serves text. "
                           f"Fetch it with: gh api /repos/{repo}/git/blobs/{payload['sha']}")


def cmd_pr(args):
    repo = resolve_repo(args.repo)
    url = gh([
        "pr", "create", "--repo", repo,
        "--base", args.base, "--head", args.head,
        "--title", args.title, "--body", args.body,
    ]).strip().splitlines()[-1].strip()
    view = json.loads(gh([
        "pr", "view", url, "--repo", repo, "--json", "number,url",
    ]))
    if args.merge:
        gh(["pr", "merge", url, "--repo", repo, "--auto", "--squash"])
    return {"number": view["number"], "url": view["url"]}


def _emit(result, as_json, human):
    if as_json:
        print(json.dumps(result))
    else:
        print(human)


def _print_usage():
    path = os.path.join(usage_dir(), "usage.jsonl")
    if not os.path.exists(path):
        print("no usage yet", file=sys.stderr)
        return 0
    n = ok = 0
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
                n += 1
                ok += 1 if rec.get("ok") else 0
            except (ValueError, KeyError):
                continue
    print(json.dumps({"calls": n, "ok": ok, "fail": n - ok}))
    return 0


class _Parser(argparse.ArgumentParser):
    """Usage errors exit 1 (general), not argparse's default 2 — exit 2 is
    documented to mean gh-not-authed, and a missing --title must not send an
    agent off to run `gh auth login`. Subparsers inherit this class."""

    def error(self, message):
        self.print_usage(sys.stderr)
        print(f"{self.prog}: error: {message}", file=sys.stderr)
        sys.exit(1)


def build_parser():
    parser = _Parser(prog="gitx")
    parser.add_argument("--usage", action="store_true", help="print usage stats and exit")
    sub = parser.add_subparsers(dest="cmd")

    p_put = sub.add_parser("put", help="atomic commit of files to a branch")
    p_put.add_argument("branch")
    p_put.add_argument("paths", nargs="+")
    p_put.add_argument("-m", "--message", required=True)
    p_put.add_argument("--repo")
    p_put.add_argument("--from", dest="from_ref")
    p_put.add_argument("--base", help="commit your copy of the files was read at")
    p_put.add_argument("--force", action="store_true",
                       help="overwrite even if the branch changed the files since your copy")
    p_put.add_argument("--json", action="store_true")

    p_cat = sub.add_parser("cat", help="read a file at a ref")
    p_cat.add_argument("ref_path", metavar="<ref>:<path>")
    p_cat.add_argument("--repo")
    p_cat.add_argument("--json", action="store_true")

    p_pr = sub.add_parser("pr", help="open (and optionally auto-merge) a PR")
    p_pr.add_argument("base")
    p_pr.add_argument("head")
    p_pr.add_argument("--title", required=True)
    p_pr.add_argument("--body", required=True)
    p_pr.add_argument("--merge", action="store_true")
    p_pr.add_argument("--repo")
    p_pr.add_argument("--json", action="store_true")
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.usage:
        return _print_usage()
    if not args.cmd:
        parser.print_help()
        return 1

    start = time.time()

    def _morgue(signum, frame):
        log_usage(args.cmd, False, int((time.time() - start) * 1000),
                  f"killed by {signal.Signals(signum).name}")
        sys.exit(128 + signum)
    signal.signal(signal.SIGTERM, _morgue)
    signal.signal(signal.SIGINT, _morgue)

    try:
        if args.cmd == "put":
            result = cmd_put(args)
            _emit(result, args.json, f"{result['sha'][:8]} {result['url']}")
        elif args.cmd == "cat":
            result = cmd_cat(args)
            _emit(result, args.json, result["content"])
        elif args.cmd == "pr":
            result = cmd_pr(args)
            _emit(result, args.json, f"#{result['number']} {result['url']}")
        else:
            parser.print_help()
            return 1
        log_usage(args.cmd, True, int((time.time() - start) * 1000), None)
        return 0
    except GitxError as e:
        if args.json:
            print(json.dumps({"error": ERROR_NAMES.get(e.code, "error"), "code": e.code,
                              "message": e.msg.splitlines()[0], **e.data}))
        else:
            print(e.msg, file=sys.stderr)
        log_usage(args.cmd, False, int((time.time() - start) * 1000), e.msg.splitlines()[0])
        return e.code


if __name__ == "__main__":
    sys.exit(main())
